node_modules/

# Transcoded output, staged for upload as release assets and then thrown away.
# Never committed: the whole design of this repository is that the audio lives
# in releases, not in git history — see README.md.
/build/

# Audition shortlist staged by the seed-selection step. Derived from build/.
/candidates/

__pycache__/

# Model files for scripts/tag-tracks.py (~2.4 GB). Outside build/, which
# sync-upstream empties on every run.
/.cache/
